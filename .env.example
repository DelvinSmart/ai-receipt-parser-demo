# Copia este archivo a ".env" y completa con tus claves reales.
# ".env" nunca se commitea (ver .gitignore) — este archivo de ejemplo
# sí se commitea, pero solo con valores vacíos/ficticios.

# Proveedor a usar por defecto: "openai" o "gemini".
RECEIPT_PARSER_PROVIDER=openai

# Clave de OpenAI (necesaria si RECEIPT_PARSER_PROVIDER=openai).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Clave de Google Gemini (necesaria si RECEIPT_PARSER_PROVIDER=gemini).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
